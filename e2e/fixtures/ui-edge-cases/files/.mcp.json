{
  "mcpServers": {
    "fixture-docs": {
      "command": "npx",
      "args": [
        "-y",
        "fixture-docs-server"
      ],
      "env": {
        "DOCS_TOKEN": "${DOCS_TOKEN}"
      }
    },
    "fixture-db": {
      "type": "http",
      "url": "https://example.invalid/mcp"
    },
    "fixture-search": {
      "command": "uvx",
      "args": [
        "fixture-search",
        "--api-key",
        "FIXTURE-FAKE-KEY-0001"
      ],
      "env": {
        "SEARCH_REGION": "eu"
      }
    }
  }
}
